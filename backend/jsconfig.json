{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "baseUrl": "./",
    "allowJs": true,
    "noEmit": true,
    "checkJs": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@helpers/*": ["helpers/*"],
      "@middlewares/*": ["middlewares/*"],
      "@utilities/*": ["helpers/utilities/*"],
      "@schemas/*": ["schemas/*"],
      "@services/*": ["services/*"],
      "@constants/*": ["constants/*"],
      "@db/*": ["helpers/db/*"],
      "@models/*": ["models/*"],
      "@routes/*": ["routes/*"],
      "@controllers/*": ["controllers/*"],
      "@mongoose-middleware/*": ["models/middlewares/*"],
      "@transaction/*": ["models/transactions/*"],
      "@lib/*": ["lib/*"],
      "@worker/*": ["worker/*"]
    }
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", ".cache"]
}
